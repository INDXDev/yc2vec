# YC2Vec configuration. Copy to .env and adjust; every value has a safe default.
# This file contains no secrets, and the pipeline needs none: there are no
# hosted-API keys because every model call runs locally through Ollama.

# --- profile ---------------------------------------------------------------
# fixture  : no model download; runs from committed sample data (used by CI)
# balanced : qwen3.8:27b + qwen3-embedding:8b (the default)
# flagship : an explicitly selected large local model; see README hardware notes
YC2VEC_PROFILE=balanced

# --- models ----------------------------------------------------------------
# The names must match what `ollama list` reports exactly. YC2Vec never
# substitutes a different model for you; `yc2vec doctor` tells you what is
# installed if the configured name is missing.
YC2VEC_CHAT_MODEL=qwen3.8:27b
YC2VEC_EMBEDDING_MODEL=qwen3-embedding:8b
YC2VEC_OLLAMA_HOST=http://localhost:11434

# Context window for classification calls. Larger costs memory, not accuracy.
YC2VEC_NUM_CTX=8192
# Seed for every stochastic step (sampling, hard-negative choice, UMAP, KMeans).
YC2VEC_SEED=20240917
# Qwen3.8 is a hybrid-reasoning model. Thinking is off for classification: it
# costs many tokens and does not improve a schema-constrained decision.
YC2VEC_THINK=false

# --- data ------------------------------------------------------------------
YC2VEC_DATA_DIR=./data
YC2VEC_SOURCE_BASE_URL=https://yc-oss.github.io/api

# --- optional website enrichment -------------------------------------------
# Off by default. When on, the crawler obeys robots.txt, identifies itself,
# throttles per domain, refuses private addresses, and stores only extracted
# text in the local cache. Read the "Website enrichment" section of the README
# before enabling this.
YC2VEC_ENABLE_CRAWL=false
YC2VEC_CRAWL_DELAY=1.0

# --- frontend --------------------------------------------------------------
# GitHub Pages project sites serve under /<repo>/. Use "/" for a custom domain.
VITE_BASE_PATH=/yc2vec/
