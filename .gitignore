# --- generated data --------------------------------------------------------
# Raw source payloads, the model-response cache and extracted website text are
# regenerable and, in the crawler's case, third-party content we must not
# redistribute. The published release under data/public/ IS committed, because
# that is what the site serves.
data/cache/
data/raw/
data/runs/
data/normalized/
data/inferred/*.npz
data/*.tmp*

# --- python ----------------------------------------------------------------
.venv/
__pycache__/
*.py[cod]
.pytest_cache/
.mypy_cache/
.ruff_cache/
.coverage
htmlcov/
dist/
build/
*.egg-info/

# --- node ------------------------------------------------------------------
node_modules/
frontend/dist/
frontend/.vite/

# --- local -----------------------------------------------------------------
.env
.DS_Store
*.log

# Intermediate derived tables are large and regenerable. The ontology itself is
# committed (it is the expensive, reviewable artifact); the vector dumps and the
# per-judgment audit tables are not.
data/inferred/*.npz
data/inferred/company_embeddings.jsonl
data/inferred/company_neighbors.jsonl
data/inferred/company_tag_judgments.partial.jsonl

# Full-fidelity analytical exports are large and reproducible from the pipeline.
# The browser-ready release under data/public/ is what the site serves and IS
# committed; researchers regenerate data/export/ with `make publish`.
data/export/
