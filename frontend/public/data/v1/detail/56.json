fidence":0.513,"evidence":[{"doc":"ycoss:1488#yc_one_liner","quote":"Complete fare payment platform for public transportation"}],"facet":"customer","name":"Consumer Facing","rationale":"The supplied description matches this attribute's definition.","raw_confidence":0.63,"shortlist_reason":"retrieval","tag_id":"consumer-facing","value":0.1047,"weight":0.204}],"team_size":12,"top_company":false,"uncertain_tags":[{"name":"Machine Learning Core","notes":"insufficient public description","tag_id":"machine-learning-core"}],"website":"https://tokentransit.com","yc_url":"https://www.ycombinator.com/companies/token-transit"},"ycoss:1763":{"all_locations":"Boston, MA, USA","batch":"Winter 2018","batch_year":2018,"company_id":"ycoss:1763","coordinates":{"cluster":2,"x":-0.4718,"y":-0.359},"former_names":[],"industries":["Government"],"industry":"Government","is_hiring":false,"logo_url":"https://bookface-images.s3.amazonaws.com/small_logos/df9a4889e935ddd93b4102bb586d2990073ca598.png","long_description":"Our mission is to transform wastewater infrastructure into public health observatories. Named as one of Fast Company’s most innovative companies in the world in 2021, Biobot Analytics is a wastewater epidemiology company and uses technology developed at MIT to measure biomarkers in sewage to better understand population health in cities. We first launched an opioid product to support government and public health officials in responding to the opioid epidemic, and in 2020 launched a Covid19 product to estimate the scope and trend of the outbreak in communities. We have operated in almost 500 communities across 43 U.S. states, generating Covid19 case estimates for over 13% of the U.S. population. Battling the opioid epidemic and now the Covid19 pandemic is just the beginning - we’re transforming sewage into a data asset and building a public health database. Eventually, Biobot data will be an early warning system for disease outbreaks, a map of nutrition disparities, and more. Please visit our website at www.biobot.io","metadata_document":"Biobot Analytics is a Y Combinator company. It participated in the Winter 2018 batch, in 2018. Its status is active. Its stage is early. Y Combinator lists its industry as Government. Y Combinator source tags: Health Tech, Analytics. It is located in Boston, MA, USA. Listed regions: United States of America, America / Canada, Remote, Partly Remote. Its team size is 12. It launched in 2017.","name":"Biobot Analytics","neighbors":{"combined":[{"batch":"Summer 2008","id":"ycoss:282","name":"Poll Everywhere","one_liner":"Interactive meetings and presentations","score":0.6571,"shared_metadata":["region: America / Canada","region: Remote","region: United States of America","status: Active"],"shared_tags":["Machine Learning Core","Regulated Domain","Structured Data","Workflow Automation"]},{"batch":"Summer 2011","id":"ycoss:86","name":"Codecademy","one_liner":"The leading online learning platform for technical skills.","score":0.6364,"shared_metadata":["region: America / Canada","region: Partly Remote","region: Remote","region: United States of America"],"shared_tags":["Consumer Facing","Marketplace Model","Regulated Domain","Structured Data"]},{"batch":"Winter 2007","id":"ycoss:346","name":"Octopart","one_liner":"Octopart is a search engine for electronic components","score":0.6297,"shared_metadata":["region: America / Canada","region: United States of America","stage: Early"],"shared_tags":["Enterprise Buyer","Marketplace Model","Regulated Domain","Structured Data"]},{"batch":"Winter 2017","id":"ycoss:1488","name":"Token Transit","one_liner":"Complete fare payment platform for public transportation","score":0.6168,"shared_metadata":["industry: Government","region: America / Canada","region: Partly Remote","region: Remote","region: United States of America","stage: Early"],"shared_tags":["Consumer Facing","Enterprise Buyer","Subscription Revenue","Workflow Automation"]},{"batch":"Summer 2010","id":"ycoss:186","